    "icon": "icon/icon.ico",
    "package": ["zip"]
  },
  "linux": {
    "container": "deckbuild-sniper",
    "package": ["tar.gz"]
  },
  "macos": {
    "icon": "icon/icon.icns",
    "package": ["zip"]
  }
}
