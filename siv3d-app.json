{
  "name": "My App",
  "exeName": "MyApp",
  "version": "1.0.0",
  "bundleId": "com.example.myapp",
  "company": "",
  "copyright": "",

  "assets": [
    { "from": "assets", "to": "assets" }
  ],

  "cmake": {
    "options": {
      "SIV3D_WITH_MOVIEPLAYER": "ON",
      "SIV3D_WITH_FFMPEG": "ON"
