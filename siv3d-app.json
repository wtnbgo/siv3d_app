{
  "name": "My App",
  "exeName": "MyApp",
  "version": "1.0.0",
  "bundleId": "jp.wamsoft.sample.siv3d",
  "company": "",
  "copyright": "",

  "siv3d": {
    "repository": "https://github.com/wtnbgo/OpenSiv3D.git",
    "ref": "develop_sdl3"
  },

  "assets": [
    { "from": "assets", "to": "assets" }
  ],

  "cmake": {
    "options": {
      "SIV3D_WITH_MOVIEPLAYER": "ON",
      "SIV3D_WITH_FFMPEG": "ON"
    }
  },

  "windows": {
    "console": false,
    "icon": "icon/icon.ico",
    "package": ["zip"]
  },
  "linux": {
    "container": "deckbuild-sniper",
    "package": ["tar.gz"]
  },
  "macos": {
    "icon": "icon/icon.icns",
    "package": ["zip"]
  },
  "web": {
    "port": 8080,
    "package": ["zip"]
  },
  "android": {
    "versionCode": 1,
    "abis": ["arm64-v8a", "x86_64"],
    "package": ["apk"]
  },
  "ios": {
    "displayName": "My App",
    "build": "1",
    "deploymentTarget": "15.0",
    "orientations": "landscape",
    "team": ""
  }
}
